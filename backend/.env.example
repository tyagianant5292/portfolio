# Server
PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
# Add your Vercel URL and your Kubernetes/Ingress URL here.
ALLOWED_ORIGINS=http://localhost:3000,https://anant-portfolio.vercel.app

# SMTP — used to email contact-form submissions.
# Example with Gmail: create an App Password (not your normal password).
# Leave SMTP_HOST empty to run without email (messages are just logged).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tyagianant98@gmail.com
SMTP_PASS=your-app-password-here

# Where contact emails are sent / shown as sender.
MAIL_TO=tyagianant98@gmail.com
MAIL_FROM=tyagianant98@gmail.com
